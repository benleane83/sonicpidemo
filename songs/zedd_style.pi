# Zedd - Clarity (Inspired Sonic Pi Demo)
# Created with GitHub Copilot

use_bpm 128

# Intro - atmospheric pad
with_fx :reverb, mix: 0.6 do
  with_fx :echo, phase: 0.5, mix: 0.3 do
    2.times do
      synth :hollow, note: :e4, sustain: 2, release: 2, amp: 0.5
      sleep 2
    end
  end
end

# Chord progression (I - V - vi - IV in E major)
def play_chords
  chords = [chord(:e4, :major), chord(:b4, :major), chord(:c5, :minor), chord(:a4, :major)]
  2.times do
    chords.each do |ch|
      synth :prophet, note: ch, sustain: 1.5, release: 0.5, amp: 0.7
      sleep 2
    end
  end
end

# Main melody (simplified, inspired by "Clarity")
def main_melody
  use_synth :blade
  notes = [:b4, :c5, :b4, :g#4, :e5, :b4, :c5, :b4, :g#4, :e5]
  durs = [0.5, 0.5, 0.5, 1, 0.5, 0.5, 0.5, 0.5, 0.5, 1]
  2.times do
    notes.zip(durs).each do |n, d|
      play n, release: d * 0.8, amp: 1.2
      sleep d
    end
  end
end

# Sidechain effect (ducking)
def sidechain
  with_fx :compressor, threshold: 0.2, clamp_time: 0.01, slope_above: 0.5 do
    yield
  end
end

# Drums
live_loop :kick do
  sample :bd_tek, amp: 2
  sleep 1
end

live_loop :snare, sync: :kick do
  sleep 1
  sample :sn_dolf, amp: 1.2
  sleep 1
end

live_loop :hats, sync: :kick do
  sleep 0.5
  sample :drum_cymbal_closed, amp: 0.7, rate: 1.5
  sleep 0.5
end

# Arrangement
in_thread do
  sleep 4
  sidechain do
    play_chords
  end
  sleep 2
  main_melody
end
